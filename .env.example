# Sao chép file này thành .env rồi điền giá trị: cp .env.example .env
# .env đã nằm trong .gitignore, KHÔNG commit key thật.

# ===================================================
# Giọng đọc (Text-to-Speech)
# ===================================================
# Engine: edge (miễn phí online) | vbee (trả phí) | vieneu (offline, chạy trên máy)
TTS_PROVIDER=edge

# Giọng mặc định:
# - Edge: vi-VN-NamMinhNeural (nam), vi-VN-HoaiMyNeural (nữ)
# - Vbee: dán nguyên mã giọng (voice_code) copy từ giao diện Vbee,
#         vd n_hanoi_male_protrainer_education_vc
# - VieNeu: tên giọng dựng sẵn, vd Minh Đức, Trúc Ly, Ngọc Linh...
TTS_VOICE=vi-VN-NamMinhNeural

# Tốc độ đọc: 1.0 = bình thường, 1.1 = nhanh hơn 10%, 0.9 = chậm hơn (khoảng 0.1 - 1.9)
TTS_SPEED=1.05

# ===================================================
# Vbee TTS API (chỉ cần khi TTS_PROVIDER=vbee) — đăng ký tại https://vbee.vn
# ===================================================
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=

# ===================================================
# VieNeu-TTS (chỉ cần khi TTS_PROVIDER=vieneu) — giọng tiếng Việt chạy offline
# https://github.com/pnnbao97/VieNeu-TTS — đường dẫn thư mục đã cài (có .venv)
# ===================================================
VIENEU_ROOT=/path/to/Voice_VieNeu-TTS

# ===================================================
# OpenAI Images API (tạo ảnh nét vẽ bằng gen_openai_image.py)
# Tạo API key tại https://platform.openai.com/api-keys
# LƯU Ý: đây là API trả phí theo dùng, KHÁC gói ChatGPT Plus (Plus không có API).
# ===================================================
OPENAI_API_KEY=
